# ─── Supabase ──────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Anthropic Claude ─────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-sonnet-5-5.
# CLAUDE_MODEL=claude-sonnet-5-5

# ─── Automations (Make.com / n8n) ─────────────────────────────────────
# Long random string. Send it as the `x-webhook-secret` header.
# Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ─── App access ───────────────────────────────────────────────────────
# Password for the login screen. Strongly recommended in production so
# strangers can't read your data or spend your Claude credits.
APP_PASSWORD=choose-a-strong-password
# UUID that owns your rows (user_id column). Any UUID works; keep it stable.
OWNER_USER_ID=00000000-0000-0000-0000-000000000001
