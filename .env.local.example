# ─── Supabase ──────────────────────────────────────────────────────────
# Project Settings → API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Server-only. Never expose this to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── AI: Google Gemini (free tier) ────────────────────────────────────
# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional. Defaults to gemini-3.8-flash. Use gemini-3.5-flash-lite for
# higher free-tier rate limits.
# GEMINI_MODEL=gemini-3.8-flash

# ─── AI: Anthropic Claude (optional, paid) ────────────────────────────
# If set, Claude is used instead of Gemini.
# https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
# Force a provider when both keys are set: gemini | claude
# AI_PROVIDER=gemini

# ─── Automations (Make.com / n8n) ─────────────────────────────────────
# Long random string. Send it as the `x-webhook-secret` header.
# Generate one with:  openssl rand -hex 32
WEBHOOK_SECRET=change-me-to-a-long-random-string

# ─── App access ───────────────────────────────────────────────────────
# Password for the login screen. Strongly recommended in production so
# strangers can't read your data or use up your AI quota.
APP_PASSWORD=choose-a-strong-password
# UUID that owns your rows (user_id column). Any UUID works; keep it stable.
OWNER_USER_ID=00000000-0000-0000-0000-000000000001
